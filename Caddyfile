{
	# Acesso por IP não envia SNI; sem isso o Caddy não acha o certificado dentro do Docker.
	default_sni {$SITE_ADDRESS}
}

# Proxy reverso com HTTPS. SITE_ADDRESS vem do .env (ex.: input.blau.com).
# Certificado da Blau em ./certs (montado em /certs, fora do git e da imagem):
#   cert.pem = certificado + intermediários (cadeia completa), key.pem = chave privada.
# O Caddy redireciona http:// para https:// sozinho.
{$SITE_ADDRESS} {
	tls /certs/cert.pem /certs/key.pem
	encode gzip
	reverse_proxy input-arquivos:8004
}
