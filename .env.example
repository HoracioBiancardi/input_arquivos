# Caminho do SQLite local de configuração da aplicação (contexts, usuários, audit log)
APP_CONFIG_DB_PATH=data/app_config.db

# Chave usada para assinar o cookie de sessão do login.
# Gere uma chave aleatória forte em produção, ex.: python -c "import secrets; print(secrets.token_hex(32))"
# Se deixado no valor padrão abaixo, a aplicação gera e persiste uma chave
# aleatória automaticamente em data/.session_secret na primeira execução.
SESSION_SECRET=change-me-in-production

# Habilita /docs, /redoc e /openapi.json. Mantenha false em qualquer ambiente
# acessível pela rede.
DEBUG=false

# Tamanho máximo aceito para um arquivo enviado, em bytes (padrão: 200 MB).
MAX_UPLOAD_SIZE_BYTES=209715200

# Se a aplicação estiver atrás de HTTPS (direto ou via proxy reverso), troque
# para true — o cookie de sessão só será enviado pelo navegador em conexões
# HTTPS.
SESSION_COOKIE_SECURE=false

# Credenciais do primeiro usuário admin, criado automaticamente no bootstrap
# se a tabela de usuários estiver vazia. Troque a senha após o primeiro login.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123

# Servidor MinIO compartilhado por todos os contexts (cada context define
# apenas o bucket que deve usar neste mesmo servidor). Usado só como
# fallback: se um admin configurar o MinIO em /admin/settings, aquela
# configuração (cifrada em repouso) tem prioridade sobre estas variáveis,
# sem precisar reiniciar o servidor.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Servidor
HOST=0.0.0.0
PORT=8080
RELOAD=false
